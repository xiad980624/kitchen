# 复制为 .env 后再填写；不要把真实值提交进 Git。
POSTGRES_DB=littlekitchen
POSTGRES_USER=littlekitchen
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://littlekitchen:replace-with-a-long-random-password@db:5432/littlekitchen
JWT_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_DAYS=30
# 原生 iOS App 不需要 CORS；仅本地调试网页时才填写，例如 http://localhost:3000
CORS_ORIGINS=
MEDIA_ROOT=/app/data/uploads
